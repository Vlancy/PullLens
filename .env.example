APP_NAME=PullLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
TELESCOPE_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pulllens
DB_USERNAME=pulllens
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey is Redis-compatible, so Laravel keeps using REDIS_* names.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=pulllens
PUSHER_APP_KEY=change-me
PUSHER_APP_SECRET=change-me
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

# ── PullLens ────────────────────────────────────────────────────────────────
# Public self-service registration is disabled; the first account is created by
# `php artisan db:seed`. ADMIN_PASSWORD is REQUIRED before seeding in production.
REGISTRATION_ENABLED=false
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Reject inbound provider webhooks that carry no valid HMAC signature.
# Always enforced in production regardless of this value.
WEBHOOK_REQUIRE_SIGNATURE=true

# Docker
APP_PORT=80
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
SOKETI_FORWARD_PORT=6001
SOKETI_DEBUG=0
# Change UID and GID to match `id -u` and `id -g` if bind-mounted files have permission issues.
UID=1000
GID=1000
