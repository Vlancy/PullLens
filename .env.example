APP_NAME=PullLens
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Production default. Set to `debug` only while diagnosing something: debug logging
# is noisy and records request context that may include sensitive values.
LOG_LEVEL=warning
TELESCOPE_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pulllens
DB_USERNAME=pulllens
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS. install.sh keeps this in step with
# APP_URL, and production forces it on whenever APP_URL is an https:// address.
# A browser discards a Secure cookie that arrived over plain http://, so leaving
# this true on an http:// instance costs the session and answers 419 to every login.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must stay above the longest job timeout (the AI review job, 180s). Below it, a slow
# review is released to a second worker while the first is still running - paying for
# the review twice and posting its findings to the pull request twice.
REDIS_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey is Redis-compatible, so Laravel keeps using REDIS_* names.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=pulllens
PUSHER_APP_KEY=change-me
PUSHER_APP_SECRET=change-me
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

# ── PullLens ────────────────────────────────────────────────────────────────
# Public self-service registration is disabled; the first account is created by
# `php artisan db:seed`. ADMIN_PASSWORD is REQUIRED before seeding in production.
REGISTRATION_ENABLED=false
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Serve the login screen at / instead of the public landing page.
# With this on, /docs stops responding as well, so an internal instance shows
# nothing to a visitor who has not signed in. The guide is still readable from a
# clone at docs/guide/index.html.
HOMEPAGE_LOGIN=true

# Take the "Log in" button off the landing page. The login route is unchanged and
# still reachable at /login; this only stops the page advertising it. Ignored when
# HOMEPAGE_LOGIN is true, since the home page is then the login screen.
HIDE_LOGIN=false

# Search, social and answer-engine metadata for the public landing page. The
# defaults describe PullLens; override them if you run a branded instance. APP_URL
# must be the public address - the canonical link, the sitemap, the JSON-LD and the
# link-preview image are all absolute, and a scraper cannot fetch localhost.
#   META_TITLE="PullLens - AI Code Review That Ships High-Quality Code"
#   META_DESCRIPTION="Self-hosted AI code reviewer ..."
#   META_KEYWORDS="AI code review, pull request review, ..."
#   META_IMAGE=og-image.png
#   META_IMAGE_ALT="PullLens - AI code review for every pull request"
#   META_LOCALE=en_US
#   META_THEME_COLOR=#111113

# Matomo analytics on the landing page only, never on a signed in page. Both must
# be set for the tracker to render; leave them empty and no analytics script is
# emitted at all. MATOMO_URL is the Matomo installation, MATOMO_SITE_ID the
# numeric site inside it, for example:
#   MATOMO_URL=//analytics.example.com/
#   MATOMO_SITE_ID=3
MATOMO_URL=
MATOMO_SITE_ID=

# Reject inbound provider webhooks that carry no valid HMAC signature.
# Always enforced in production regardless of this value.
WEBHOOK_REQUIRE_SIGNATURE=true

# Docker
APP_PORT=80
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
SOKETI_FORWARD_PORT=6001
SOKETI_DEBUG=0

# Which PullLens image to run. install.sh keeps these in step with the VERSION file in
# this checkout, because compose.yml and the Nginx config ship here while the
# application ships in the image - the two have to describe the same release. To run a
# particular release, check out its tag and rerun ./install.sh rather than editing
# these by hand. `./install.sh --from-source` builds this checkout instead.
PULLLENS_IMAGE=vlancy/pulllens
PULLLENS_VERSION=latest
PULLLENS_PULL_POLICY=missing

# Source builds only: these are Dockerfile build args, so the published image ignores
# them. Every mount in compose.yml is a named volume, which Docker seeds with the
# image's own ownership, so there is no host user to match when pulling.
UID=1000
GID=1000
